# Llack 웹 모드: 정적 번들을 빌드해 nginx 로 서빙.
#
# 브라우저 모드는 데스크톱과 같은 코드가 HTTP 어댑터로 도는 것이므로,
# 이 이미지 하나가 "설치 없는 Llack" 전체입니다. API 프록시 규칙은
# deploy/nginx.conf 에 있습니다 (컨테이너 이름 `api` 를 가리킵니다).
#
# 빌드 컨텍스트는 저장소 루트입니다 (deploy/nginx.conf 를 함께 담기 위해):
#   docker build -f desktop/Dockerfile.web .

FROM node:22-alpine AS builder

WORKDIR /build
COPY desktop/package.json desktop/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY desktop/index.html desktop/vite.config.ts desktop/tsconfig.json ./
COPY desktop/src ./src
RUN npx vite build

FROM nginx:1.27-alpine

COPY --from=builder /build/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
