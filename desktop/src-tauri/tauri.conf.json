{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Llack",
  "version": "0.2.0",
  "identifier": "co.hanbit.llack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Llack",
        "width": 1280,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: asset: http://asset.localhost http://127.0.0.1:8000 http://localhost:8000",
        "media-src": "'self' blob: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8000 http://localhost:8000 ws://127.0.0.1:8000 ws://localhost:8000",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© Llack",
    "category": "Productivity",
    "shortDescription": "사내 메신저",
    "longDescription": "한빛 팀을 위한 사내 메신저입니다.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
