# docker-compose 용 환경 변수. `cp .env.example .env` 후 값을 채우세요.

# 필수. 32자 이상 무작위 — 이 값으로 모든 토큰이 서명됩니다.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LLACK_SECRET_KEY=

# 초대 없이 가입 금지 (프로덕션 기본). 첫 관리자 생성 절차는 docs/DEPLOY.md.
LLACK_REQUIRE_INVITE=true

# 웹 UI 를 호스트의 어느 포트에 게시할지.
LLACK_WEB_PUBLISH=80

# 메일 (비밀번호 재설정 코드 발송). 보통은 앱 안에서 잡습니다 — 환경설정 →
# 메일 (SMTP) 에서 소유자가 입력·테스트·저장. 여기 값은 그 화면이 비어 있을 때의
# 폴백입니다. 둘 다 비면 콘솔 백엔드 — 메일 본문이 서버 로그에 남습니다.
LLACK_SMTP_HOST=
LLACK_SMTP_PORT=587
LLACK_SMTP_USER=
LLACK_SMTP_PASSWORD=
LLACK_MAIL_FROM=llack@example.com

# 첨부 바이러스 검사. compose 에 clamav 컨테이너를 붙였다면 clamav / 3310.
# 비워두면 검사하지 않고 scan_status=skipped 로 저장합니다.
LLACK_CLAMAV_HOST=
LLACK_CLAMAV_PORT=3310

# Prometheus 가 /metrics 를 긁을 때 쓸 토큰 (Authorization: Bearer …).
# 비워두면 프로덕션에서는 /metrics 가 404 입니다.
LLACK_METRICS_TOKEN=

# ── 초대 메일 · 링크 카드 ──────────────────────────────────────────────────
# 사람들이 브라우저로 여는 주소. 초대 메일의 링크에 쓰입니다. 비우면 요청의
# Origin 을 쓰고, 그것도 없으면 초대는 만들어지되 메일은 가지 않습니다.
LLACK_PUBLIC_WEB_URL=
# 메시지의 첫 링크에 제목·설명·이미지 카드를 붙입니다(서버가 한 번 가져옴, SSRF 가드).
LLACK_UNFURL_ENABLED=true
