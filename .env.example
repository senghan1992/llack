# docker-compose 용 환경 변수. `cp .env.example .env` 후 값을 채우세요.

# 필수. 32자 이상 무작위 — 이 값으로 모든 토큰이 서명됩니다.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LLACK_SECRET_KEY=

# 초대 없이 가입 금지 (프로덕션 기본). 첫 관리자 생성 절차는 docs/DEPLOY.md.
LLACK_REQUIRE_INVITE=true

# 웹 UI 를 호스트의 어느 포트에 게시할지.
LLACK_WEB_PUBLISH=80

# 메일 (비밀번호 재설정 코드 발송). 비워두면 콘솔 백엔드 — 메일 본문이
# 서버 로그에 남습니다 (개발용 · SMTP 준비 전 임시 운영용).
LLACK_SMTP_HOST=
LLACK_SMTP_PORT=587
LLACK_SMTP_USER=
LLACK_SMTP_PASSWORD=
LLACK_MAIL_FROM=llack@example.com
