# Llack 환경 변수 예시.
#
# `cp .env.example .env` 후 값을 채우세요.
#   · docker compose 는 프로젝트 루트의 .env 를 읽습니다.
#   · 백엔드를 직접 띄울 때에는 backend/.env 를 읽습니다
#     (backend/app/core/config.py 의 env_file 설정).
#
# 이름이 LLACK_ 로 시작하는 별칭도 읽습니다(SECRET_KEY → LLACK_SECRET_KEY,
# DATABASE_URL → LLACK_DATABASE_URL, UPLOAD_DIR → LLACK_UPLOAD_DIR).

# ── 어느 환경인가 ─────────────────────────────────────────────────────
# development(기본) · staging · production.
# production 이면 서버가 뜨기 전에 두 가지를 검사합니다 — 개발용 서명 키를
# 그대로 쓰고 있는지, CORS 가 "*" 인지. 둘 중 하나라도 걸리면 서버가 뜨지
# 않습니다(실수로 운영에 나가는 것을 막기 위함).
APP_ENV=development

# ── 서명 키 ────────────────────────────────────────────────────────────
# 필수. 모든 토큰(JWT)을 서명하는 키입니다. 32자 이상 무작위 값을 쓰세요.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 배포 전에 반드시 바꾸세요 — 이 값을 바꾸면 발급된 토큰이 전부 무효가 됩니다.
SECRET_KEY=

# ── 데이터베이스 ───────────────────────────────────────────────────────
# 기본값은 SQLite(backend/llack.db)입니다 — 별도 설치가 필요 없습니다.
# Postgres 를 쓰려면 아래처럼 지정하세요.
#   DATABASE_URL=postgresql+asyncpg://llack:llack@localhost:5432/llack
# DATABASE_URL=

# ── 첨부 파일 ──────────────────────────────────────────────────────────
# 업로드 파일이 저장되는 디렉터리. 기본값은 backend/var/uploads.
# 운영에서는 절대 경로를 권합니다(컨테이너에서는 볼륨을 이 경로에 붙입니다).
# UPLOAD_DIR=/var/lib/llack/uploads

# ── 첨부 파일 규칙 ─────────────────────────────────────────────────────
# 저장 규칙 전체는 docs/FILES.md 에 있습니다. 여기서 바뀌는 값들만 둡니다.
#
# 워크스페이스 하나가 파일로 쓸 수 있는 총 크기(바이트). 기본 5GiB.
# WORKSPACE_QUOTA_BYTES=5368709120

# 업로드만 하고 어떤 메시에도 붙지 않은 파일을 몇 시간 뒤에 없앨지.
# 0 이면 지우지 않습니다. 기본 24시간.
# ORPHAN_FILE_HOURS=24

# ── 속도 제한 ─────────────────────────────────────────────────────────
# 너무 많은 요청을 막는 한도입니다. 사내망에서는 여러 사람이 주소를
# 나눠 쓸 수 있으므로, 값이 너무 작으면 동료가 같이 막힙니다.
#
#   RATE_LIMIT_ENABLED=false        ← 전부 끄기(기본은 켜짐)
#   RATE_LIMIT_SIGNUP=60            ← 시간당, 주소당
#   RATE_LIMIT_LOGIN=30             ← 분당, 주소당
#   RATE_LIMIT_LOGIN_ACCOUNT=10     ← 분당, 계정당(비밀번호 추측 방지)
#   RATE_LIMIT_REFRESH=30           ← 분당, 주소당
#   RATE_LIMIT_MESSAGE=60           ← 분당, 사람당
#   RATE_LIMIT_UPLOAD=30            ← 분당, 사람당
#   RATE_LIMIT_SEARCH=60            ← 분당, 사람당
#
# 값을 0 으로 두면 그 동작에는 한도가 없습니다.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_SIGNUP=60
# RATE_LIMIT_LOGIN=30
# RATE_LIMIT_LOGIN_ACCOUNT=10
# RATE_LIMIT_REFRESH=30
# RATE_LIMIT_MESSAGE=60
# RATE_LIMIT_UPLOAD=30
# RATE_LIMIT_SEARCH=60

# ── 신뢰하는 프록시 ───────────────────────────────────────────────────
# 이 주소들에서 온 요청만 `X-Forwarded-For` 를 믿습니다. nginx 뒤에 두면
# 사내 사용자마다 다른 주소로 세어져야 합니다(한도를 사람별로 보기 위해).
# nginx 가 같은 머신에 있으면 기본값(127.0.0.1)만으로 충분합니다.
# 컨테이너로 띄우면 compose 네트워크를 함께 적으세요.
# TRUSTED_PROXY_NETWORKS=127.0.0.1,::1,172.16.0.0/12

# ── CORS ───────────────────────────────────────────────────────────────
# 허용할 오리진 목록(쉼표 구분). "*" 면 전부 허용합니다(개발용 기본값).
# 데스크톱 앱은 고정된 파일 프로토콜 오리진(tauri://localhost 등)으로 접속하므로
# 그 주소가 그대로 오리진이 됩니다. 운영에서는 실제 주소로 좁히세요.
# CORS_ORIGINS=https://llack.example.com

# ── 토큰 수명(초) ──────────────────────────────────────────────────────
# 액세스 토큰(기본 30분)과 리프레시 토큰(기본 30일)의 수명입니다.
# ACCESS_TOKEN_TTL_SECONDS=1800
# REFRESH_TOKEN_TTL_SECONDS=2592000

# ── 기타 ───────────────────────────────────────────────────────────────
# JWT 서명 알고리즘 (기본 HS256).
# JWT_ALGORITHM=HS256

# ── 데스크톱 앱이 말할 서버 주소 ──────────────────────────────────────
# 배포한 뒤에 고정되는 주소입니다. 데스크톱 앱을 빌드할 때 이 값 하나가
# 프런트엔드 번들 · CSP · Rust 셸에 함께 들어갑니다.
#   LLACK_SERVER_URL=https://atrium.arche.ai
#
# 이 값은 백엔드가 아니라 **빌드**할 때 읽습니다 — 서버 주소가 바뀔 때
# 서버를 다시 설정할 필요가 없도록 한 것입니다.
# LLACK_SERVER_URL=http://127.0.0.1:8000

# 첨부 파일 최대 크기(바이트). 기본 50MiB.
# 문서까지 공유하는 팀이면 100MiB 로 올려도 됩니다.
# MAX_UPLOAD_BYTES=52428800
