# Llack 환경 변수 예시.
#
# `cp .env.example .env` 후 값을 채우세요.
#   · docker compose 는 프로젝트 루트의 .env 를 읽습니다.
#   · 백엔드를 직접 띄울 때에는 backend/.env 를 읽습니다
#     (backend/app/core/config.py 의 env_file 설정).
#
# 이름이 LLACK_ 로 시작하는 별칭도 읽습니다(SECRET_KEY → LLACK_SECRET_KEY,
# DATABASE_URL → LLACK_DATABASE_URL, UPLOAD_DIR → LLACK_UPLOAD_DIR).

# ── 서명 키 ────────────────────────────────────────────────────────────
# 필수. 모든 토큰(JWT)을 서명하는 키입니다. 32자 이상 무작위 값을 쓰세요.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 배포 전에 반드시 바꾸세요 — 이 값을 바꾸면 발급된 토큰이 전부 무효가 됩니다.
SECRET_KEY=

# ── 데이터베이스 ───────────────────────────────────────────────────────
# 기본값은 SQLite(backend/llack.db)입니다 — 별도 설치가 필요 없습니다.
# Postgres 를 쓰려면 아래처럼 지정하세요.
#   DATABASE_URL=postgresql+asyncpg://llack:llack@localhost:5432/llack
# DATABASE_URL=

# ── 첨부 파일 ──────────────────────────────────────────────────────────
# 업로드 파일이 저장되는 디렉터리. 기본값은 backend/var/uploads.
# 운영에서는 절대 경로를 권합니다(컨테이너에서는 볼륨을 이 경로에 붙입니다).
# UPLOAD_DIR=/var/lib/llack/uploads

# ── 첨부 파일 규칙 ─────────────────────────────────────────────────────
# 저장 규칙 전체는 docs/FILES.md 에 있습니다. 여기서 바뀌는 값들만 둡니다.
#
# 워크스페이스 하나가 파일로 쓸 수 있는 총 크기(바이트). 기본 5GiB.
# WORKSPACE_QUOTA_BYTES=5368709120

# 업로드만 하고 어떤 메시에도 붙지 않은 파일을 몇 시간 뒤에 없앨지.
# 0 이면 지우지 않습니다. 기본 24시간.
# ORPHAN_FILE_HOURS=24

# ── CORS ───────────────────────────────────────────────────────────────
# 허용할 오리진 목록(쉼표 구분). "*" 면 전부 허용합니다(개발용 기본값).
# 데스크톱 앱은 고정된 파일 프로토콜 오리진(tauri://localhost 등)으로 접속하므로
# 그 주소가 그대로 오리진이 됩니다. 운영에서는 실제 주소로 좁히세요.
# CORS_ORIGINS=https://llack.example.com

# ── 토큰 수명(초) ──────────────────────────────────────────────────────
# 액세스 토큰(기본 30분)과 리프레시 토큰(기본 30일)의 수명입니다.
# ACCESS_TOKEN_TTL_SECONDS=1800
# REFRESH_TOKEN_TTL_SECONDS=2592000

# ── 기타 ───────────────────────────────────────────────────────────────
# JWT 서명 알고리즘 (기본 HS256).
# JWT_ALGORITHM=HS256

# 첨부 파일 최대 크기(바이트). 기본 50MiB.
# 문서까지 공유하는 팀이면 100MiB 로 올려도 됩니다.
# MAX_UPLOAD_BYTES=52428800
