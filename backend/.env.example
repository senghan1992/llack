# ── Core ───────────────────────────────────────────────────────────────────
# Signing key for the access/refresh tokens. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database ───────────────────────────────────────────────────────────────
# Dev default (zero-dependency):  sqlite+aiosqlite:///./llack.db
# Production:                     postgresql+asyncpg://llack:llack@localhost:5432/llack
DATABASE_URL=sqlite+aiosqlite:///./llack.db

# ── API ────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1

# Comma separated list of allowed origins, or * for every origin.
CORS_ORIGINS=*

# ── Files ──────────────────────────────────────────────────────────────────
# Where uploads are stored. Relative paths are resolved against backend/.
UPLOAD_DIR=var/uploads
