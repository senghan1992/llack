# ── Core ───────────────────────────────────────────────────────────────────
# Signing key for the access/refresh tokens. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string-in-production

# development (default) | staging | production.
# "production" refuses to start on the development signing key or a
# wildcard CORS list.
APP_ENV=development

# ── Database ───────────────────────────────────────────────────────────────
# Dev default (zero-dependency):  sqlite+aiosqlite:///./llack.db
# Production:                     postgresql+asyncpg://llack:llack@localhost:5432/llack
DATABASE_URL=sqlite+aiosqlite:///./llack.db

# ── API ────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1

# Comma separated list of allowed origins, or * for every origin.
CORS_ORIGINS=*

# ── Files ──────────────────────────────────────────────────────────────────
# Where uploads are stored. Relative paths are resolved against backend/.
UPLOAD_DIR=var/uploads

# ── Rate limits ─────────────────────────────────────────────────────────────
# Requests allowed per window. Set a scope to 0 to turn that limit off.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_SIGNUP=60
# RATE_LIMIT_LOGIN=30
# RATE_LIMIT_LOGIN_ACCOUNT=10
# RATE_LIMIT_REFRESH=30
# RATE_LIMIT_MESSAGE=60
# RATE_LIMIT_UPLOAD=30
# RATE_LIMIT_SEARCH=60

# Only requests from these addresses may set X-Forwarded-For.
# TRUSTED_PROXY_NETWORKS=127.0.0.1,::1
