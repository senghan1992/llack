# ── Core ────────────────────────────────────────────────────────────────
LLACK_ENV=development
LLACK_SECRET_KEY=change-me-to-a-long-random-string-in-production
LLACK_API_PREFIX=/api/v1

# ── Database ────────────────────────────────────────────────────────────
# Dev default (zero-dependency):  sqlite+aiosqlite:///./llack.db
# Production:                     postgresql+asyncpg://llack:llack@localhost:5432/llack
LLACK_DATABASE_URL=sqlite+aiosqlite:///./llack.db

# ── Redis (optional in dev; required for multi-worker realtime) ──────────
LLACK_REDIS_URL=

# ── Tokens ──────────────────────────────────────────────────────────────
LLACK_ACCESS_TOKEN_TTL_SECONDS=900
LLACK_REFRESH_TOKEN_TTL_SECONDS=2592000

# ── File storage: local | s3 ────────────────────────────────────────────
LLACK_STORAGE_BACKEND=local
LLACK_STORAGE_LOCAL_DIR=./var/uploads
LLACK_S3_BUCKET=
LLACK_S3_ENDPOINT_URL=
LLACK_S3_REGION=ap-northeast-2
LLACK_MAX_UPLOAD_BYTES=104857600

# ── CORS / desktop origins ──────────────────────────────────────────────
LLACK_CORS_ORIGINS=http://localhost:1420,http://localhost:5173,tauri://localhost
