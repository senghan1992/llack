<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 다크 모드에서도 동일한 Llack 스플래시를 사용한다 -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/llack_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/llack_launch_mark</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/llack_paper</item>
    </style>
</resources>
